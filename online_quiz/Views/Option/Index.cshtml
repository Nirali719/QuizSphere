@model IEnumerable<online_quiz.Models.Option>

@{
    ViewData["Title"] = "Options";
    var question = ViewBag.Question as online_quiz.Models.Question;
}

<div class="container py-4">

    <!-- Messages -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger border-0 shadow-sm mb-4">
            @TempData["Error"]
        </div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm mb-4">
            @TempData["Success"]
        </div>
    }

    <!-- Page Header -->
    <div class="d-flex flex-column flex-md-row
        justify-content-between align-items-md-center mb-5">

        <div>

            <p class="text-secondary text-uppercase fw-semibold small mb-2">
                Question Management
            </p>

            <h1 class="fw-semibold mb-2">
                Options
            </h1>

            <p class="text-secondary mb-0">
                Question:
                <span class="fw-semibold text-dark">
                    @question.QuestionText
                </span>
            </p>

        </div>

        <div class="mt-3 mt-md-0">

            <a asp-action="Create"
               asp-route-questionId="@question.Id"
               class="btn btn-dark px-4">
                Add Option
            </a>

        </div>

    </div>

    @if (!Model.Any())
    {
        <!-- Empty State -->
        <div class="card border-0 shadow-sm rounded-3 mb-4">

            <div class="card-body text-center py-5">

                <h5 class="fw-semibold mb-2">
                    No Options Yet
                </h5>

                <p class="text-secondary mb-4">
                    No options have been added to this question yet.
                </p>

                <a asp-action="Create"
                   asp-route-questionId="@question.Id"
                   class="btn btn-dark px-4">
                    Add First Option
                </a>

            </div>

        </div>
    }
    else
    {
        <!-- Options Table -->
        <div class="card border-0 shadow-sm rounded-3">

            <div class="card-body p-0">

                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th class="px-4 py-3">
                                    #
                                </th>

                                <th class="py-3">
                                    Option
                                </th>

                                <th class="py-3">
                                    Correct Answer
                                </th>

                                <th class="px-4 py-3">
                                    Actions
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @{
                                int number = 1;
                            }

                            @foreach (var option in Model)
                            {
                                <tr>

                                    <td class="px-4">
                                        <span class="text-secondary">
                                            @number
                                        </span>
                                    </td>

                                    <td>

                                        <div class="fw-semibold">
                                            @option.OptionText
                                        </div>

                                    </td>

                                    <td>

                                        @if (option.IsCorrect)
                                        {
                                            <span class="badge bg-success">
                                                Correct
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Incorrect
                                            </span>
                                        }

                                    </td>

                                    <td class="px-4">

                                        <div class="d-flex flex-wrap gap-2">

                                            <a asp-action="Edit"
                                               asp-route-id="@option.Id"
                                               class="btn btn-sm btn-outline-dark">
                                                Edit
                                            </a>

                                            <a asp-action="Delete"
                                               asp-route-id="@option.Id"
                                               class="btn btn-sm btn-outline-danger">
                                                Delete
                                            </a>

                                        </div>

                                    </td>

                                </tr>

                                number++;
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }

    <!-- Bottom Actions -->
    <div class="d-flex flex-wrap gap-2 mt-4">

        <a asp-action="Finish"
           asp-route-questionId="@question.Id"
           class="btn btn-dark px-4">
            Finish Question
        </a>

        <a asp-controller="Question"
           asp-action="Index"
           asp-route-quizId="@question.QuizId"
           class="btn btn-outline-dark px-4">
            Back to Questions
        </a>

    </div>

</div>