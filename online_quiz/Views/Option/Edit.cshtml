@model online_quiz.Models.Option

@{
    ViewData["Title"] = "Edit Option";
}

<div class="container py-4">

    <!-- Page Header -->
    <div class="mb-5">

        <p class="text-secondary text-uppercase fw-semibold small mb-2">
            Question Management
        </p>

        <h1 class="fw-semibold mb-2">
            Edit Option
        </h1>

        <p class="text-secondary mb-0">
            Update the answer option for the question below.
        </p>

    </div>

    <!-- Question Reference -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">

        <div class="card-body p-4">

            <p class="text-secondary text-uppercase fw-semibold small mb-2">
                Question
            </p>

            <div class="fw-semibold">
                @Model.Question.QuestionText
            </div>

        </div>

    </div>

    <div class="row">

        <div class="col-lg-8">

            <div class="card border-0 shadow-sm rounded-3">

                <div class="card-body p-4 p-lg-5">

                    <form asp-controller="Option"
                          asp-action="Edit"
                          method="post">

                        <input type="hidden"
                               asp-for="Id" />

                        <input type="hidden"
                               asp-for="QuestionId" />

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-4">
                        </div>

                        <!-- Option Text -->
                        <div class="mb-4">

                            <label asp-for="OptionText"
                                   class="form-label fw-semibold">
                                Option
                            </label>

                            <input asp-for="OptionText"
                                   class="form-control" />

                            <span asp-validation-for="OptionText"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- Correct Answer -->
                        <div class="border rounded-3 p-3 mb-4">

                            <div class="form-check">

                                <input asp-for="IsCorrect"
                                       class="form-check-input" />

                                <label asp-for="IsCorrect"
                                       class="form-check-label fw-semibold">
                                    This is the correct answer
                                </label>

                            </div>

                        </div>

                        <!-- Buttons -->
                        <div class="d-flex flex-wrap gap-2">

                            <button type="submit"
                                    class="btn btn-dark px-4">
                                Save Changes
                            </button>

                            <a asp-action="Index"
                               asp-route-questionId="@Model.QuestionId"
                               class="btn btn-outline-dark px-4">
                                Back to Options
                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}