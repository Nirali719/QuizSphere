@model online_quiz.Models.Option

@{
    ViewData["Title"] = "Add Option";
    var question = ViewBag.Question as online_quiz.Models.Question;
}

<div class="container mt-4">

    <h1>Add Option</h1>

    <p class="text-muted">
        Question:
        <strong>@question.QuestionText</strong>
    </p>

    <hr />

    <div class="row">

        <div class="col-md-7">

            <form asp-action="Create" method="post">

                <input type="hidden"
                       asp-for="QuestionId"
                       value="@question.Id" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger">
                </div>

                <!-- Option Text -->
                <div class="mb-3">

                    <label asp-for="OptionText"
                           class="form-label">
                        Option
                    </label>

                    <input asp-for="OptionText"
                           class="form-control"
                           placeholder="Enter option" />

                    <span asp-validation-for="OptionText"
                          class="text-danger">
                    </span>

                </div>

                <!-- Correct Answer -->
                <div class="form-check mb-3">

                    <input asp-for="IsCorrect"
                           class="form-check-input" />

                    <label asp-for="IsCorrect"
                           class="form-check-label">
                        This is the correct answer
                    </label>

                </div>

                <button type="submit"
                        class="btn btn-primary">
                    Add Option
                </button>

                <a asp-action="Index"
                   asp-route-questionId="@question.Id"
                   class="btn btn-secondary">
                    Back to Options
                </a>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}