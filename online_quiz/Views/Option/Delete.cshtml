@model online_quiz.Models.Option

@{
    ViewData["Title"] = "Delete Option";
}

<div class="container mt-4">

    <h1>Delete Option</h1>

    <hr />

    <div class="alert alert-danger">
        <strong>Are you sure you want to delete this option?</strong>
        <br />
        This action cannot be undone.
    </div>

    <dl class="row">

        <dt class="col-sm-3">
            Question
        </dt>

        <dd class="col-sm-9">
            @Model.Question.QuestionText
        </dd>

        <dt class="col-sm-3">
            Option
        </dt>

        <dd class="col-sm-9">
            @Model.OptionText
        </dd>

        <dt class="col-sm-3">
            Correct Answer
        </dt>

        <dd class="col-sm-9">

            @if (Model.IsCorrect)
            {
                <span class="badge bg-success">
                    Correct
                </span>
            }
            else
            {
                <span class="badge bg-secondary">
                    Incorrect
                </span>
            }

        </dd>

    </dl>

    <form asp-controller="Option"
          asp-action="Delete"
          method="post">

        <input type="hidden"
               asp-for="Id" />

        <button type="submit"
                class="btn btn-danger">
            Delete Option
        </button>

        <a asp-action="Index"
           asp-route-questionId="@Model.QuestionId"
           class="btn btn-secondary">
            Cancel
        </a>

    </form>

</div>