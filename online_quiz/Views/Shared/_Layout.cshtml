<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - QuizSphere</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/online_quiz.styles.css" asp-append-version="true" />
</head>

<body class="d-flex flex-column min-vh-100">

    <header>

        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">

            <div class="container">

                <!-- Brand -->
                <a class="navbar-brand fw-semibold"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">

                    QuizSphere

                </a>

                <!-- Mobile Menu Button -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <!-- Navigation -->
                <div class="collapse navbar-collapse"
                     id="mainNavbar">

                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Index">

                                Home

                            </a>

                        </li>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (User.IsInRole("ADMIN"))
                            {
                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Admin"
                                       asp-action="Index">

                                        Dashboard

                                    </a>

                                </li>
                            }

                            @if (User.IsInRole("FACULTY"))
                            {
                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Faculty"
                                       asp-action="Index">

                                        Dashboard

                                    </a>

                                </li>
                            }

                            @if (User.IsInRole("PARTICIPANT"))
                            {
                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Participant"
                                       asp-action="Index">

                                        Dashboard

                                    </a>

                                </li>
                            }
                        }

                    </ul>

                    <!-- Login / User Section -->
                    <div class="d-flex align-items-center">

                        <partial name="_LoginPartial" />

                    </div>

                </div>

            </div>

        </nav>

    </header>


    <!-- Main Content -->

    <main role="main" class="flex-grow-1">

        <div class="container py-4">

            @RenderBody()

        </div>

    </main>


    <!-- Footer -->

    <footer class="border-top bg-dark text-light">

        <div class="container py-3">

            <div class="d-flex justify-content-between align-items-center">

                <span class="text-light">
                    &copy; 2026 QuizSphere
                </span>

                <a class="text-decoration-none text-light"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Privacy">

                    Privacy

                </a>

            </div>

        </div>

    </footer>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>