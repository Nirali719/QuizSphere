@model IEnumerable<online_quiz.Models.Subject>

@{
    ViewData["Title"] = "Subjects";
}

<div class="container py-4">

    <!-- Page Header -->

    <div class="d-flex flex-column flex-md-row justify-content-between
                align-items-md-center mb-5">

        <div>

            <p class="text-secondary text-uppercase fw-semibold small mb-2">
                Content Management
            </p>

            <h1 class="fw-semibold mb-2">
                Subjects
            </h1>

            <p class="text-secondary mb-0">
                Create and manage the subjects available in the quiz portal.
            </p>

        </div>

        

    </div>


    @if (!Model.Any())
    {
        <!-- Empty State -->

        <div class="card border-0 shadow-sm">

            <div class="card-body text-center py-5">

                <h5 class="fw-semibold mb-2">
                    No Subjects Available
                </h5>

                <p class="text-secondary mb-4">
                    No subjects have been created yet.
                </p>

                <a asp-action="Create"
                   class="btn btn-dark px-4">

                    Create Your First Subject

                </a>

            </div>

        </div>
    }
    else
    {
        <!-- Subjects Table -->

        <div class="card border-0 shadow-sm">

            <div class="card-body p-0">

                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                            <th class="px-4 py-3">
                                Subject Name
                            </th>

                            <th class="py-3">
                                Category
                            </th>

                            <th class="py-3">
                                Description
                            </th>

                                <th class="py-3">
                                    Status
                                </th>

                                <th class="py-3 pe-4">
                                    Actions
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var subject in Model)
                            {
                                <tr>

                                    <td class="px-4 py-3">

                                        <span class="fw-semibold">
                                            @subject.Name
                                        </span>

                                    </td>

                                    <td class="py-3">
                                        <span class="text-secondary">
                                            @subject.Category?.Name
                                        </span>
                                    </td>

                                    <td class="py-3">

                                        <span class="text-secondary">
                                            @subject.Description
                                        </span>

                                    </td>


                                    <td class="py-3">

                                        @if (subject.IsActive)
                                        {
                                            <span class="badge bg-success">
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                Inactive
                                            </span>
                                        }

                                    </td>


                                    <td class="py-3 pe-4">

                                        <div class="d-flex flex-wrap gap-2">

                                            @if (subject.IsActive)
                                            {
                                                <a asp-action="Edit"
                                                   asp-route-id="@subject.Id"
                                                   class="btn btn-sm btn-outline-dark">

                                                    Edit

                                                </a>

                                                <a asp-action="Delete"
                                                   asp-route-id="@subject.Id"
                                                   class="btn btn-sm btn-outline-danger">

                                                    Deactivate

                                                </a>
                                            }
                                            else
                                            {
                                                <a asp-action="Activate"
                                                   asp-route-id="@subject.Id"
                                                   class="btn btn-sm btn-outline-success">

                                                    Activate

                                                </a>
                                            }

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }

</div>