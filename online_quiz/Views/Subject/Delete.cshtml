@model online_quiz.Models.Subject

@{
    ViewData["Title"] = "Deactivate Subject";
}

<div class="container py-4">

    <!-- Page Header -->

    <div class="mb-5">

        <p class="text-secondary text-uppercase fw-semibold small mb-2">
            Content Management
        </p>

        <h1 class="fw-semibold mb-2">
            Deactivate Subject
        </h1>

        <p class="text-secondary mb-0">
            Review the subject details before deactivating it.
        </p>

    </div>


    <!-- Confirmation Card -->

    <div class="row">

        <div class="col-md-8 col-lg-7">

            <div class="card border-0 shadow-sm">

                <div class="card-body p-4 p-lg-5">

                    <!-- Warning -->

                    <div class="mb-4">

                        <h5 class="fw-semibold mb-2">
                            Confirm Deactivation
                        </h5>

                        <p class="text-secondary mb-0">
                            Are you sure you want to deactivate this subject?
                            The subject will no longer be active, but existing
                            quizzes and records will remain safe.
                        </p>

                    </div>


                    <!-- Subject Details -->

                    <div class="border rounded-3 p-4 mb-4">

                        <div class="row mb-3">

                            <div class="col-sm-4 text-secondary">
                                Subject Name
                            </div>

                            <div class="col-sm-8 fw-semibold">
                                @Model.Name
                            </div>

                        </div>


                        <div class="row mb-3">

                            <div class="col-sm-4 text-secondary">
                                Description
                            </div>

                            <div class="col-sm-8">
                                @Model.Description
                            </div>

                        </div>


                        <div class="row">

                            <div class="col-sm-4 text-secondary">
                                Current Status
                            </div>

                            <div class="col-sm-8">

                                @if (Model.IsActive)
                                {
                                    <span class="badge bg-success">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        Inactive
                                    </span>
                                }

                            </div>

                        </div>

                    </div>


                    <!-- Actions -->

                    <form asp-action="Delete" method="post">

                        <input type="hidden" asp-for="Id" />

                        <div class="d-flex flex-wrap gap-2">

                            <button type="submit"
                                    class="btn btn-danger px-4">

                                Deactivate Subject

                            </button>

                            <a asp-action="Index"
                               class="btn btn-outline-dark px-4">

                                Cancel

                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>