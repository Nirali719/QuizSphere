@model IEnumerable<online_quiz.Models.Quiz>

@{
    ViewData["Title"] = "Manage Quizzes";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <div>
            <h1>Manage Quizzes</h1>
            <p class="text-muted">
                View and manage all quizzes submitted by Faculty.
            </p>
        </div>

    </div>

    <hr />

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No quizzes have been created yet.
        </div>
    }
    else
    {
        <table class="table table-bordered table-striped">

            <thead>
                <tr>
                    <th>#</th>
                    <th>Quiz</th>
                    <th>Subject</th>
                    <th>Faculty</th>
                    <th>Total Marks</th>
                    <th>Passing Marks</th>
                    <th>Time</th>
                    <th>Max Attempts</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>

                @{
                    int number = 1;
                }

                @foreach (var quiz in Model)
                {
                    <tr>

                        <td>@number</td>

                        <td>
                            <strong>@quiz.Title</strong>
                            <br />
                            <small class="text-muted">
                                @quiz.Description
                            </small>
                        </td>

                        <td>
                            @quiz.Subject?.Name
                        </td>

                        <td>
                            @quiz.Faculty?.FullName
                        </td>

                        <td>
                            @quiz.TotalMarks
                        </td>

                        <td>
                            @quiz.PassingMarks
                        </td>

                        <td>
                            @quiz.TimeLimit min
                        </td>

                        <td>
                            @if (quiz.MaxAttempts == 0)
                            {
                                <span>Unlimited</span>
                            }
                            else
                            {
                                <span>@quiz.MaxAttempts</span>
                            }
                        </td>

                        <td>

                            @if (quiz.Status == "PENDING")
                            {
                                <span class="badge bg-warning text-dark">
                                    PENDING
                                </span>
                            }

                            else if (quiz.Status == "APPROVED")
                            {
                                <span class="badge bg-success">
                                    APPROVED
                                </span>
                            }
                            else if (quiz.Status == "REJECTED")
                            {
                                <span class="badge bg-danger">
                                    REJECTED
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    @quiz.Status
                                </span>
                            }

                        </td>

                        <td>

                            @if (quiz.Status == "PENDING")
                            {
                                <form asp-controller="AdminQuiz"
                                      asp-action="Approve"
                                      asp-route-id="@quiz.Id"
                                      method="post"
                                      style="display:inline;">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-sm btn-success">
                                        Approve
                                    </button>

                                </form>

                                <form asp-controller="AdminQuiz"
                                      asp-action="Reject"
                                      asp-route-id="@quiz.Id"
                                      method="post"
                                      style="display:inline;">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-sm btn-danger">
                                        Reject
                                    </button>

                                </form>
                            }
                            else
                            {
                                <span class="text-muted">
                                    No action
                                </span>
                            }

                        </td>

                    </tr>

                    number++;
                }

            </tbody>

        </table>
    }

</div>