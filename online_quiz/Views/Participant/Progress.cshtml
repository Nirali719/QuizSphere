@model IEnumerable<dynamic>

@{
    ViewData["Title"] = "My Progress";
}

<div class="container py-4">

    <!-- Page Header -->
    <div class="mb-5">

        <p class="text-secondary text-uppercase fw-semibold small mb-2">
            Performance Analytics
        </p>

        <h1 class="fw-semibold mb-2">
            My Progress
        </h1>

        <p class="text-secondary mb-0">
            View your subject-wise quiz performance and progress.
        </p>

    </div>

    @if (!Model.Any())
    {
        <!-- Empty State -->
        <div class="card border-0 shadow-sm rounded-3">

            <div class="card-body p-4">

                <p class="text-secondary text-uppercase fw-semibold small mb-2">
                    Progress
                </p>

                <h5 class="fw-semibold mb-2">
                    No Progress Available
                </h5>

                <p class="text-secondary mb-0">
                    You have not attempted any quizzes yet.
                </p>

            </div>

        </div>
    }
    else
    {
        <!-- Progress Table -->
        <div class="card border-0 shadow-sm rounded-3">

            <div class="card-body p-0">

                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th class="px-4 py-3">
                                    Subject
                                </th>

                                <th class="py-3">
                                    Quizzes Attempted
                                </th>

                                <th class="py-3">
                                    Average Score
                                </th>

                                <th class="py-3">
                                    Average Percentage
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var item in Model)
                            {
                                <tr>

                                    <td class="px-4">

                                        <div class="fw-semibold">
                                            @item.SubjectName
                                        </div>

                                    </td>

                                    <td>
                                        @item.QuizzesAttempted
                                    </td>

                                    <td>
                                        <span class="fw-semibold">
                                            @item.AverageScore.ToString("0.00")
                                        </span>
                                    </td>

                                    <td>
                                        <span class="fw-semibold">
                                            @item.AveragePercentage.ToString("0.00")%
                                        </span>
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }

    <!-- Back to Dashboard -->
    <div class="mt-5">

        <a asp-controller="Participant"
           asp-action="Index"
           class="btn btn-outline-dark px-4">
            Back to Dashboard
        </a>

    </div>

</div>