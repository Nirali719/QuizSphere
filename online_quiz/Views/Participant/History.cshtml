@model IEnumerable<online_quiz.Models.Result>

@{
    ViewData["Title"] = "Attempt History";
}

<div class="container mt-4">

    <h1>Attempt History</h1>

    <p class="text-muted">
        Here you can see the quizzes you have attempted and your results.
    </p>

    <hr />

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            You have not attempted any quizzes yet.
        </div>
    }
    else
    {
        <table class="table table-bordered table-striped">

            <thead>
                <tr>
                    <th>Quiz</th>
                    <th>Subject</th>
                    <th>Score</th>
                    <th>Total Marks</th>
                    <th>Percentage</th>
                    <th>Result</th>
                    <th>Attempted On</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var result in Model)
                {
                    <tr>

                        <td>
                            @result.QuizAttempt?.Quiz?.Title
                        </td>

                        <td>
                            @result.QuizAttempt?.Quiz?.Subject?.Name
                        </td>

                        <td>
                            @result.Score
                        </td>

                        <td>
                            @result.TotalMarks
                        </td>

                        <td>
                            @result.Percentage.ToString("0.00")%
                        </td>

                        <td>

                            @if (result.IsPassed)
                            {
                                <span class="badge bg-success">
                                    PASS
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger">
                                    FAIL
                                </span>
                            }

                        </td>

                        <td>
                            @result.QuizAttempt?.EndTime?.ToString("dd-MM-yyyy HH:mm")
                        </td>

                        <td>

                            <a asp-controller="Participant"
                               asp-action="Result"
                               asp-route-id="@result.Id"
                               class="btn btn-sm btn-primary">
                                View Result
                            </a>

                        </td>

                    </tr>
                }

            </tbody>

        </table>
    }

</div>