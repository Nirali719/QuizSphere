@model online_quiz.Models.Quiz

@{
    ViewData["Title"] = "Attempt Quiz";
}

<div class="container py-4">

    <!-- Quiz Header -->
    <div class="mb-4">

        <p class="text-secondary text-uppercase fw-semibold small mb-2">
            Quiz Attempt
        </p>

        <h1 class="fw-semibold mb-2">
            @Model.Title
        </h1>

        <p class="text-secondary mb-3">
            Subject:
            <strong>@Model.Subject?.Name</strong>
        </p>

        <div class="d-flex flex-wrap gap-4 text-secondary">

            <div>
                <span class="small">Total Marks</span>
                <div class="fw-semibold text-dark">
                    @Model.TotalMarks
                </div>
            </div>

            <div>
                <span class="small">Passing Marks</span>
                <div class="fw-semibold text-dark">
                    @Model.PassingMarks
                </div>
            </div>

            <div>
                <span class="small">Time Limit</span>
                <div class="fw-semibold text-dark">
                    @Model.TimeLimit minutes
                </div>
            </div>

        </div>

    </div>

    <!-- Timer -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">

        <div class="card-body p-3 text-center">

            <div class="text-secondary small mb-1">
                Time Remaining
            </div>

            <div id="timer"
                 class="fw-semibold fs-4">
                Loading...
            </div>

        </div>

    </div>

    <!-- Quiz Form -->
    <form id="quizForm"
          asp-controller="Participant"
          asp-action="SubmitAttempt"
          method="post">

        @Html.AntiForgeryToken()

        <input type="hidden"
               name="QuizId"
               value="@Model.Id" />

        <input type="hidden"
               name="AttemptId"
               value="@ViewBag.AttemptId" />

        @if (Model.Questions != null && Model.Questions.Any())
        {
            int number = 1;

            @foreach (var question in Model.Questions.OrderBy(q => q.Id))
            {
                <div class="card border-0 shadow-sm rounded-3 mb-4">

                    <div class="card-body p-4">

                        <!-- Question Header -->
                        <div class="d-flex justify-content-between align-items-start mb-3">

                            <div>

                                <p class="text-secondary text-uppercase fw-semibold small mb-1">
                                    Question @number
                                </p>

                                <h5 class="fw-semibold mb-0">
                                    @question.QuestionText
                                </h5>

                            </div>

                            <span class="badge bg-light text-dark border">
                                @question.Marks mark(s)
                            </span>

                        </div>

                        <!-- Options -->
                        <div class="mt-4">

                            @foreach (var option in question.Options ?? new List<online_quiz.Models.Option>())
                            {
                                <div class="border rounded-3 p-3 mb-2">

                                    <div class="form-check">

                                        <input class="form-check-input"
                                               type="radio"
                                               name="Answers[@question.Id]"
                                               value="@option.Id"
                                               id="option_@option.Id" />

                                        <label class="form-check-label"
                                               for="option_@option.Id">

                                            @option.OptionText

                                        </label>

                                    </div>

                                </div>
                            }

                        </div>

                    </div>

                </div>

                number++;
            }

            <!-- Submit -->
            <div class="d-flex justify-content-end mt-4">

                <button type="submit"
                        id="submitQuizButton"
                        class="btn btn-dark px-4">
                    Submit Quiz
                </button>

            </div>
        }
        else
        {
            <div class="card border-0 shadow-sm rounded-3">

                <div class="card-body p-4">

                    <h5 class="fw-semibold mb-2">
                        No Questions Available
                    </h5>

                    <p class="text-secondary mb-0">
                        This quiz does not have any questions yet.
                    </p>

                </div>

            </div>
        }

    </form>

</div>

<script>

    // Get the remaining time calculated by the SERVER
    let timeRemaining = @ViewBag.RemainingSeconds;

    const timer = document.getElementById("timer");

    // Select ONLY the quiz form
    const form = document.getElementById("quizForm");

    let isSubmitting = false;

    function updateTimer()
    {
        let minutes = Math.floor(timeRemaining / 60);

        let seconds = timeRemaining % 60;

        seconds = seconds < 10
            ? "0" + seconds
            : seconds;

        timer.textContent =
            minutes + ":" + seconds;

        if (timeRemaining <= 0)
        {
            clearInterval(timerInterval);

            if (!isSubmitting)
            {
                isSubmitting = true;

                timer.textContent = "Time's Up!";

                // Submit ONLY the quiz form
                form.submit();
            }

            return;
        }

        timeRemaining--;
    }

    updateTimer();

    const timerInterval = setInterval(updateTimer, 1000);

</script>