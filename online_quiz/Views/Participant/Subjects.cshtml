@model IEnumerable<online_quiz.Models.Subject>

@{
    ViewData["Title"] = "Select Subject";
}

<div class="container py-4">

    <!-- Page Header -->
    <div class="mb-5">

        <p class="text-secondary text-uppercase fw-semibold small mb-2">
            Quiz Selection
        </p>

        <h1 class="fw-semibold mb-2">
            Select Subject
        </h1>

        <p class="text-secondary mb-1">
            Category: <span class="fw-semibold">@ViewBag.CategoryName</span>
        </p>

        <p class="text-secondary mb-0">
            Select a subject to view the approved quizzes available to you.
        </p>

    </div>

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-3">

            <div class="card-body p-4">

                <h5 class="fw-semibold mb-2">
                    No Subjects Available
                </h5>

                <p class="text-secondary mb-0">
                    No subjects are available at the moment.
                </p>

            </div>

        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var subject in Model)
            {
                <div class="col-md-6 col-lg-4">

                    <div class="card border-0 shadow-sm rounded-3 h-100">

                        <div class="card-body p-4 d-flex flex-column">

                            <p class="text-secondary text-uppercase fw-semibold small mb-3">
                                Subject
                            </p>

                            <h5 class="fw-semibold mb-2">
                                @subject.Name
                            </h5>

                            <p class="text-secondary mb-4 flex-grow-1">
                                @subject.Description
                            </p>

                            <div>

                                <a asp-controller="Participant"
                                   asp-action="Quizzes"
                                   asp-route-subjectId="@subject.Id"
                                   class="btn btn-dark px-4">
                                    View Quizzes
                                </a>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

    <!-- Back to Dashboard -->
    <div class="mt-5">

        <a asp-controller="Participant"
           asp-action="Categories"
           class="btn btn-outline-dark px-4">
            Back to Categories
        </a>

    </div>

</div>