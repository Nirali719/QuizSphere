@model IEnumerable<online_quiz.Models.Subject>

@{
    ViewData["Title"] = "Select Subject";
}

<div class="container mt-4">

    <h1>Select Subject</h1>

    <p class="text-muted">
        Select a subject to view its approved quizzes.
    </p>

    <hr />

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No subjects are available at the moment.
        </div>
    }
    else
    {
        <div class="row">

            @foreach (var subject in Model)
            {
                <div class="col-md-4 mb-4">

                    <div class="card h-100">

                        <div class="card-body">

                            <h4 class="card-title">
                                @subject.Name
                            </h4>

                            <p class="card-text">
                                @subject.Description
                            </p>

                            <a asp-controller="Participant"
                               asp-action="Quizzes"
                               asp-route-subjectId="@subject.Id"
                               class="btn btn-primary">
                                View Quizzes
                            </a>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

    <div class="mt-4">

        <a asp-controller="Participant"
           asp-action="Index"
           class="btn btn-secondary">
            Back to Dashboard
        </a>

    </div>

</div>