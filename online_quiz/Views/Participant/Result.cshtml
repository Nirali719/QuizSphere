@model online_quiz.Models.Result

@{
    ViewData["Title"] = "Quiz Result";

    var answers = ViewBag.Answers
        as List<online_quiz.Models.StudentAnswer>;
}

<div class="container py-4">

    <!-- Page Header -->
    <div class="mb-5">

        <p class="text-secondary text-uppercase fw-semibold small mb-2">
            Assessment Result
        </p>

        <h1 class="fw-semibold mb-2">
            Quiz Result
        </h1>

        <p class="text-secondary mb-0">
            Review your performance and answer details.
        </p>

    </div>

    <!-- Time Expired -->
    @if (TempData["TimeExpired"] != null)
    {
        <div class="alert alert-warning border-0 shadow-sm rounded-3 mb-4">

            <div class="fw-semibold mb-1">
                Time's Up!
            </div>

            <div>
                @TempData["TimeExpired"]
            </div>

        </div>
    }

    <!-- Quiz Information -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">

        <div class="card-body p-4">

            <p class="text-secondary text-uppercase fw-semibold small mb-2">
                Quiz
            </p>

            <h3 class="fw-semibold mb-2">
                @Model.QuizAttempt?.Quiz?.Title
            </h3>

            <p class="text-secondary mb-0">
                Subject:
                <strong>@Model.QuizAttempt?.Quiz?.Subject?.Name</strong>
            </p>

        </div>

    </div>

    <!-- Answer Summary -->
    <div class="mb-4">

        <p class="text-secondary text-uppercase fw-semibold small mb-3">
            Answer Summary
        </p>

        <div class="row g-3">

            <!-- Total Questions -->
            <div class="col-6 col-lg-3">

                <div class="card border-0 shadow-sm rounded-3 h-100">

                    <div class="card-body p-4">

                        <div class="text-secondary small mb-2">
                            Total Questions
                        </div>

                        <div class="fs-3 fw-semibold">
                            @Model.TotalQuestions
                        </div>

                    </div>

                </div>

            </div>

            <!-- Correct -->
            <div class="col-6 col-lg-3">

                <div class="card border-0 shadow-sm rounded-3 h-100">

                    <div class="card-body p-4">

                        <div class="text-secondary small mb-2">
                            Correct Answers
                        </div>

                        <div class="fs-3 fw-semibold">
                            @Model.CorrectAnswers
                        </div>

                    </div>

                </div>

            </div>

            <!-- Incorrect -->
            <div class="col-6 col-lg-3">

                <div class="card border-0 shadow-sm rounded-3 h-100">

                    <div class="card-body p-4">

                        <div class="text-secondary small mb-2">
                            Incorrect Answers
                        </div>

                        <div class="fs-3 fw-semibold">
                            @Model.IncorrectAnswers
                        </div>

                    </div>

                </div>

            </div>

            <!-- Unattempted -->
            <div class="col-6 col-lg-3">

                <div class="card border-0 shadow-sm rounded-3 h-100">

                    <div class="card-body p-4">

                        <div class="text-secondary small mb-2">
                            Unattempted
                        </div>

                        <div class="fs-3 fw-semibold">
                            @Model.Unattempted
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- Score -->
    <div class="card border-0 shadow-sm rounded-3 mb-5">

        <div class="card-body p-4 p-lg-5 text-center">

            <p class="text-secondary text-uppercase fw-semibold small mb-2">
                Final Score
            </p>

            <h2 class="fw-semibold mb-2">
                @Model.Score / @Model.TotalMarks
            </h2>

            <p class="text-secondary mb-4">
                Percentage:
                <strong>@Model.Percentage.ToString("0.00")%</strong>
            </p>

            @if (Model.IsPassed)
            {
                <div class="border border-success rounded-3 p-3">

                    <div class="fw-semibold text-success mb-1">
                        PASS
                    </div>

                    <div class="text-secondary">
                        Congratulations! You have passed the quiz.
                    </div>

                </div>
            }
            else
            {
                <div class="border border-danger rounded-3 p-3">

                    <div class="fw-semibold text-danger mb-1">
                        FAIL
                    </div>

                    <div class="text-secondary">
                        You did not reach the passing marks.
                    </div>

                </div>
            }

        </div>

    </div>

    <!-- Answer Review -->
    <div class="mb-4">

        <p class="text-secondary text-uppercase fw-semibold small mb-2">
            Answer Review
        </p>

        <h2 class="fw-semibold mb-2">
            Review Your Answers
        </h2>

        <p class="text-secondary mb-4">
            Review your answers and see the correct answers.
        </p>

    </div>

    @if (answers != null && answers.Any())
    {
        int questionNumber = 1;

        @foreach (var answer in answers)
        {
            var correctOption = answer.Question?.Options?
                .FirstOrDefault(o => o.IsCorrect);

            <div class="card border-0 shadow-sm rounded-3 mb-4">

                <div class="card-body p-4">

                    <!-- Question Header -->
                    <div class="d-flex justify-content-between align-items-start mb-3">

                        <div>

                            <p class="text-secondary text-uppercase fw-semibold small mb-1">
                                Question @questionNumber
                            </p>

                            <h5 class="fw-semibold mb-0">
                                @answer.Question?.QuestionText
                            </h5>

                        </div>

                    </div>

                    <!-- Your Answer -->
                    <div class="border rounded-3 p-3 mb-3">

                        <div class="text-secondary small mb-1">
                            Your Answer
                        </div>

                        @if (answer.SelectedOption != null)
                        {
                            <div class="fw-semibold">
                                @answer.SelectedOption.OptionText
                            </div>
                        }
                        else
                        {
                            <div class="text-secondary">
                                Not Attempted
                            </div>
                        }

                    </div>

                    <!-- Correct Answer -->
                    <div class="border rounded-3 p-3 mb-3">

                        <div class="text-secondary small mb-1">
                            Correct Answer
                        </div>

                        @if (correctOption != null)
                        {
                            <div class="fw-semibold">
                                @correctOption.OptionText
                            </div>
                        }
                        else
                        {
                            <div class="text-danger">
                                Not available
                            </div>
                        }

                    </div>

                    <!-- Answer Status -->
                    @if (answer.SelectedOptionId == null)
                    {
                        <div class="border border-warning rounded-3 p-3">

                            <div class="fw-semibold">
                                Unattempted
                            </div>

                        </div>
                    }
                    else if (answer.SelectedOption?.IsCorrect == true)
                    {
                        <div class="border border-success rounded-3 p-3">

                            <div class="fw-semibold text-success">
                                Correct Answer
                            </div>

                        </div>
                    }
                    else
                    {
                        <div class="border border-danger rounded-3 p-3">

                            <div class="fw-semibold text-danger">
                                Incorrect Answer
                            </div>

                        </div>
                    }

                </div>

            </div>

            questionNumber++;
        }
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-3">

            <div class="card-body p-4">

                <h5 class="fw-semibold mb-2">
                    No Answer Details
                </h5>

                <p class="text-secondary mb-0">
                    No answer details are available.
                </p>

            </div>

        </div>
    }

    <!-- Navigation -->
    <div class="mt-5 mb-4">

        <a asp-controller="Participant"
   asp-action="Categories"
   class="btn btn-outline-dark px-4">
    Back to Categories
</a>

    </div>

</div>