@model IEnumerable<online_quiz.Models.Quiz>

@{
    ViewData["Title"] = "Available Quizzes";

    var attemptCounts =
        ViewBag.AttemptCounts as Dictionary<int, int>
        ?? new Dictionary<int, int>();
}

<div class="container py-4">

    <!-- Page Header -->
    <div class="mb-5">

        <p class="text-secondary text-uppercase fw-semibold small mb-2">
            Quiz Selection
        </p>

        <h1 class="fw-semibold mb-2">
            Available Quizzes
        </h1>

        <p class="text-secondary mb-0">
            View approved quizzes and attempt the assessments available for you.
        </p>

    </div>

    <!-- Error Message -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-warning border-0 shadow-sm rounded-3 mb-4">
            @TempData["Error"]
        </div>
    }

    @if (!Model.Any())
    {
        <!-- Empty State -->
        <div class="card border-0 shadow-sm rounded-3">

            <div class="card-body p-4">

                <p class="text-secondary text-uppercase fw-semibold small mb-2">
                    Assessments
                </p>

                <h5 class="fw-semibold mb-2">
                    No Approved Quizzes Available
                </h5>

                <p class="text-secondary mb-0">
                    No approved quizzes are available at the moment.
                </p>

            </div>

        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var quiz in Model)
            {
                int attemptCount = 0;

                if (attemptCounts.ContainsKey(quiz.Id))
                {
                    attemptCount = attemptCounts[quiz.Id];
                }

                bool maxAttemptsReached =
                    quiz.MaxAttempts > 0 &&
                    attemptCount >= quiz.MaxAttempts;

                <div class="col-md-6">

                    <div class="card border-0 shadow-sm rounded-3 h-100">

                        <div class="card-body p-4 d-flex flex-column">

                            <!-- Quiz Header -->
                            <div class="mb-4">

                                <p class="text-secondary text-uppercase fw-semibold small mb-2">
                                    Quiz
                                </p>

                                <h4 class="fw-semibold mb-2">
                                    @quiz.Title
                                </h4>

                                <p class="text-secondary mb-1">
                                    Category:
                                    <strong>@quiz.Subject?.Category?.Name</strong>
                                </p>

                                <p class="text-secondary mb-0">
                                    Subject:
                                    <strong>@quiz.Subject?.Name</strong>
                                </p>

                            </div>

                            <!-- Description -->
                            <p class="text-secondary mb-4">
                                @quiz.Description
                            </p>

                            <!-- Quiz Details -->
                            <div class="border rounded-3 p-3 mb-4">

                                <div class="row g-3">

                                    <div class="col-6">

                                        <div class="text-secondary small">
                                            Total Marks
                                        </div>

                                        <div class="fw-semibold">
                                            @quiz.TotalMarks
                                        </div>

                                    </div>

                                    <div class="col-6">

                                        <div class="text-secondary small">
                                            Passing Marks
                                        </div>

                                        <div class="fw-semibold">
                                            @quiz.PassingMarks
                                        </div>

                                    </div>

                                    <div class="col-6">

                                        <div class="text-secondary small">
                                            Time Limit
                                        </div>

                                        <div class="fw-semibold">
                                            @quiz.TimeLimit minutes
                                        </div>

                                    </div>

                                    <div class="col-6">

                                        <div class="text-secondary small">
                                            Maximum Attempts
                                        </div>

                                        <div class="fw-semibold">

                                            @if (quiz.MaxAttempts == 0)
                                            {
                                                <span>Unlimited</span>
                                            }
                                            else
                                            {
                                                <span>@quiz.MaxAttempts</span>
                                            }

                                        </div>

                                    </div>

                                </div>

                            </div>

                            <!-- Attempt Information -->
                            @if (quiz.MaxAttempts > 0)
                            {
                                <div class="mb-4">

                                    <div class="text-secondary small mb-1">
                                        Your Attempts
                                    </div>

                                    <div class="fw-semibold">
                                        @attemptCount / @quiz.MaxAttempts
                                    </div>

                                </div>
                            }

                            <!-- Action -->
                            <div class="mt-auto">

                                @if (maxAttemptsReached)
                                {
                                    <div class="border border-warning rounded-3 p-3">

                                        <div class="fw-semibold mb-1">
                                            Maximum Attempts Reached
                                        </div>

                                        <p class="text-secondary mb-0 small">
                                            You have already used all
                                            @quiz.MaxAttempts
                                            attempts for this quiz.
                                            You cannot attempt this quiz again.
                                        </p>

                                    </div>
                                }
                                else
                                {
                                    <a asp-controller="Participant"
                                       asp-action="Attempt"
                                       asp-route-id="@quiz.Id"
                                       class="btn btn-dark px-4">
                                        Attempt Quiz
                                    </a>
                                }

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

    <!-- Back -->
    <div class="mt-5">

        <a asp-controller="Participant"
           asp-action="Subjects"
           asp-route-categoryId="@Model.FirstOrDefault()?.Subject?.CategoryId"
           class="btn btn-outline-dark px-4">
            Back to Subjects
        </a>

    </div>

</div>