@model online_quiz.Models.Question

@{
    ViewData["Title"] = "Add Question";
    var quiz = ViewBag.Quiz as online_quiz.Models.Quiz;
}

<div class="container mt-4">

    <h1>Add Question</h1>

    <p class="text-muted">
        Quiz: <strong>@quiz.Title</strong>
    </p>

    <hr />

    <div class="row">

        <div class="col-md-7">

            <form asp-action="Create" method="post">

                <input type="hidden"
                       asp-for="QuizId"
                       value="@quiz.Id" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger">
                </div>

                <!-- Question Text -->
                <div class="mb-3">

                    <label asp-for="QuestionText"
                           class="form-label">
                        Question
                    </label>

                    <textarea asp-for="QuestionText"
                              class="form-control"
                              rows="4"
                              placeholder="Enter question">
                    </textarea>

                    <span asp-validation-for="QuestionText"
                          class="text-danger">
                    </span>

                </div>

                <!-- Marks -->
                <div class="mb-3">

                    <label asp-for="Marks"
                           class="form-label">
                        Marks
                    </label>

                    <input asp-for="Marks"
                           type="number"
                           min="1"
                           class="form-control"
                           placeholder="Enter marks" />

                    <span asp-validation-for="Marks"
                          class="text-danger">
                    </span>

                </div>

                <button type="submit"
                        class="btn btn-primary">
                    Add Question
                </button>

                <a asp-action="Index"
                   asp-route-quizId="@quiz.Id"
                   class="btn btn-secondary">
                    Back to Questions
                </a>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}