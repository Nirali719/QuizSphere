@model online_quiz.Models.Question

@{
    ViewData["Title"] = "Add Question";
    var quiz = ViewBag.Quiz as online_quiz.Models.Quiz;
}

<div class="container py-4">

    <!-- Page Header -->
    <div class="mb-5">

        <p class="text-secondary text-uppercase fw-semibold small mb-2">
            Quiz Management
        </p>

        <h1 class="fw-semibold mb-2">
            Add Question
        </h1>

        <p class="text-secondary mb-0">
            Add a new question to
            <span class="fw-semibold text-dark">
                @quiz.Title
            </span>.
        </p>

    </div>

    <div class="row">

        <div class="col-lg-8">

            <div class="card border-0 shadow-sm rounded-3">

                <div class="card-body p-4 p-lg-5">

                    <form asp-action="Create" method="post">

                        <input type="hidden"
                               asp-for="QuizId"
                               value="@quiz.Id" />

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-4">
                        </div>

                        <!-- Question Text -->
                        <div class="mb-4">

                            <label asp-for="QuestionText"
                                   class="form-label fw-semibold">
                                Question
                            </label>

                            <textarea asp-for="QuestionText"
                                      class="form-control"
                                      rows="5"
                                      placeholder="Enter question"></textarea>

                            <span asp-validation-for="QuestionText"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- Marks -->
                        <div class="mb-4">

                            <label asp-for="Marks"
                                   class="form-label fw-semibold">
                                Marks
                            </label>

                            <input asp-for="Marks"
                                   type="number"
                                   min="1"
                                   class="form-control"
                                   placeholder="Enter marks" />

                            <span asp-validation-for="Marks"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- Buttons -->
                        <div class="d-flex flex-wrap gap-2 mt-4">

                            <button type="submit"
                                    class="btn btn-dark px-4">
                                Add Question
                            </button>

                            <a asp-action="Index"
                               asp-route-quizId="@quiz.Id"
                               class="btn btn-outline-dark px-4">
                                Back to Questions
                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}