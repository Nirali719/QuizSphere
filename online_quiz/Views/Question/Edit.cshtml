@model online_quiz.Models.Question

@{
    ViewData["Title"] = "Edit Question";
}

<div class="container mt-4">

    <h1>Edit Question</h1>

    <hr />
    @if (ViewBag.Errors != null)
    {
        foreach (var error in ViewBag.Errors)
        {
            <div class="alert alert-danger">
                @error
            </div>
        }
    }

    <div class="row">

        <div class="col-md-7">

            <form asp-controller="Question"
                  asp-action="Edit"
                  method="post">

                <input type="hidden"
                       asp-for="Id" />

                <input type="hidden"
                       asp-for="QuizId" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger">
                </div>

                <!-- Question Text -->
                <div class="mb-3">

                    <label asp-for="QuestionText"
                           class="form-label">
                        Question
                    </label>

                    <textarea asp-for="QuestionText"
                              class="form-control"
                              rows="4">
                    </textarea>

                    <span asp-validation-for="QuestionText"
                          class="text-danger">
                    </span>

                </div>

                <!-- Marks -->
                <div class="mb-3">

                    <label asp-for="Marks"
                           class="form-label">
                        Marks
                    </label>

                    <input asp-for="Marks"
                           type="number"
                           min="1"
                           class="form-control" />

                    <span asp-validation-for="Marks"
                          class="text-danger">
                    </span>

                </div>

                <button type="submit"
                        class="btn btn-primary">
                    Save Changes
                </button>

                <a asp-action="Index"
                   asp-route-quizId="@Model.QuizId"
                   class="btn btn-secondary">
                    Back to Questions
                </a>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}