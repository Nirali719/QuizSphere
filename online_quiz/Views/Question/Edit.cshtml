@model online_quiz.Models.Question

@{
    ViewData["Title"] = "Edit Question";
}

<div class="container py-4">

    <!-- Page Header -->
    <div class="mb-5">

        <p class="text-secondary text-uppercase fw-semibold small mb-2">
            Quiz Management
        </p>

        <h1 class="fw-semibold mb-2">
            Edit Question
        </h1>

        <p class="text-secondary mb-0">
            Update the question and its marks.
        </p>

    </div>

    <!-- Additional Errors -->
    @if (ViewBag.Errors != null)
    {
        foreach (var error in ViewBag.Errors)
        {
            <div class="alert alert-danger border-0 shadow-sm mb-3">
                @error
            </div>
        }
    }

    <div class="row">

        <div class="col-lg-8">

            <div class="card border-0 shadow-sm rounded-3">

                <div class="card-body p-4 p-lg-5">

                    <form asp-controller="Question"
                          asp-action="Edit"
                          method="post">

                        <input type="hidden"
                               asp-for="Id" />

                        <input type="hidden"
                               asp-for="QuizId" />

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-4">
                        </div>

                        <!-- Question Text -->
                        <div class="mb-4">

                            <label asp-for="QuestionText"
                                   class="form-label fw-semibold">
                                Question
                            </label>

                            <textarea asp-for="QuestionText"
                                      class="form-control"
                                      rows="5"></textarea>

                            <span asp-validation-for="QuestionText"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- Marks -->
                        <div class="mb-4">

                            <label asp-for="Marks"
                                   class="form-label fw-semibold">
                                Marks
                            </label>

                            <input asp-for="Marks"
                                   type="number"
                                   min="1"
                                   class="form-control" />

                            <span asp-validation-for="Marks"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- Buttons -->
                        <div class="d-flex flex-wrap gap-2 mt-4">

                            <button type="submit"
                                    class="btn btn-dark px-4">
                                Save Changes
                            </button>

                            <a asp-action="Index"
                               asp-route-quizId="@Model.QuizId"
                               class="btn btn-outline-dark px-4">
                                Back to Questions
                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}