@model online_quiz.Models.Question

@{
    ViewData["Title"] = "Delete Question";
}

<div class="container py-4">

    <!-- Page Header -->
    <div class="mb-5">

        <p class="text-secondary text-uppercase fw-semibold small mb-2">
            Quiz Management
        </p>

        <h1 class="fw-semibold mb-2">
            Delete Question
        </h1>

        <p class="text-secondary mb-0">
            Review the question before confirming deletion.
        </p>

    </div>

    <!-- Warning -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">

        <div class="card-body p-4">

            <h5 class="fw-semibold text-danger mb-2">
                Confirm Question Deletion
            </h5>

            <p class="text-secondary mb-0">
                Are you sure you want to delete this question?
                This will also delete all options belonging to this question.
            </p>

        </div>

    </div>

    <!-- Question Information -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">

        <div class="card-body p-4 p-lg-5">

            <p class="text-secondary text-uppercase fw-semibold small mb-2">
                Question Information
            </p>

            <div class="mb-4">

                <div class="text-secondary small mb-1">
                    Question
                </div>

                <div class="fw-semibold">
                    @Model.QuestionText
                </div>

            </div>

            <div class="border rounded-3 p-3">

                <div class="text-secondary small mb-1">
                    Marks
                </div>

                <div class="fw-semibold">
                    @Model.Marks
                </div>

            </div>

        </div>

    </div>

    <!-- Actions -->
    <div class="d-flex flex-wrap gap-2">

        <form asp-action="Delete"
              method="post"
              class="d-inline">

            <input type="hidden"
                   asp-for="Id" />

            <button type="submit"
                    class="btn btn-danger px-4">
                Delete Question
            </button>

        </form>

        <a asp-action="Index"
           asp-route-quizId="@Model.QuizId"
           class="btn btn-outline-dark px-4">
            Cancel
        </a>

    </div>

</div>