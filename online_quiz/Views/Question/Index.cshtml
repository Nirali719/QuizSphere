@model IEnumerable<online_quiz.Models.Question>

@{
    ViewData["Title"] = "Questions";
    var quiz = ViewBag.Quiz as online_quiz.Models.Quiz;
}

<div class="container py-4">

    <!-- Page Header -->
    <div class="d-flex flex-column flex-md-row
        justify-content-between align-items-md-center mb-5">

        <div>

            <p class="text-secondary text-uppercase fw-semibold small mb-2">
                Quiz Management
            </p>

            <h1 class="fw-semibold mb-2">
                @quiz.Title
            </h1>

            <p class="text-secondary mb-0">
                Manage questions and answer options for this quiz.
            </p>

        </div>

        <div class="mt-3 mt-md-0">

            <a asp-action="Create"
               asp-route-quizId="@quiz.Id"
               class="btn btn-dark px-4">
                Add Question
            </a>

        </div>

    </div>

    @if (!Model.Any())
    {
        <!-- Empty State -->
        <div class="card border-0 shadow-sm rounded-3 mb-4">

            <div class="card-body text-center py-5">

                <h5 class="fw-semibold mb-2">
                    No Questions Yet
                </h5>

                <p class="text-secondary mb-4">
                    No questions have been added to this quiz yet.
                </p>

                <a asp-action="Create"
                   asp-route-quizId="@quiz.Id"
                   class="btn btn-dark px-4">
                    Add Your First Question
                </a>

            </div>

        </div>
    }
    else
    {
        <!-- Questions Table -->
        <div class="card border-0 shadow-sm rounded-3 mb-4">

            <div class="card-body p-0">

                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th class="px-4 py-3">
                                    #
                                </th>

                                <th class="py-3">
                                    Question
                                </th>

                                <th class="py-3">
                                    Marks
                                </th>

                                <th class="px-4 py-3">
                                    Actions
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @{
                                int number = 1;
                            }

                            @foreach (var question in Model)
                            {
                                <tr>

                                    <td class="px-4">
                                        <span class="text-secondary">
                                            @number
                                        </span>
                                    </td>

                                    <td>
                                        <div class="fw-semibold">
                                            @question.QuestionText
                                        </div>
                                    </td>

                                    <td>
                                        <span class="fw-semibold">
                                            @question.Marks
                                        </span>
                                    </td>

                                    <td class="px-4">

                                        <div class="d-flex flex-wrap gap-2">

                                            <a asp-controller="Option"
                                               asp-action="Index"
                                               asp-route-questionId="@question.Id"
                                               class="btn btn-sm btn-outline-dark">
                                                Options
                                            </a>

                                            <a asp-action="Edit"
                                               asp-route-id="@question.Id"
                                               class="btn btn-sm btn-outline-dark">
                                                Edit
                                            </a>

                                            <a asp-action="Delete"
                                               asp-route-id="@question.Id"
                                               class="btn btn-sm btn-outline-danger">
                                                Delete
                                            </a>

                                        </div>

                                    </td>

                                </tr>

                                number++;
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }

    <!-- Back Button -->
    <a asp-controller="Quiz"
       asp-action="Index"
       class="btn btn-outline-dark px-4">
        Back to My Quizzes
    </a>

</div>