@model IEnumerable<online_quiz.Models.Result>

@{
    ViewData["Title"] = "All Participant Results";
}

<div class="container py-4">

    <!-- Page Header -->

    <div class="mb-5">

        <p class="text-secondary text-uppercase fw-semibold small mb-2">
            Reports
        </p>

        <h1 class="fw-semibold mb-2">
            Participant Results
        </h1>

        <p class="text-secondary mb-0">
            View quiz results and performance records of all participants.
        </p>

    </div>


    @if (!Model.Any())
    {
        <!-- Empty State -->

        <div class="card border-0 shadow-sm">

            <div class="card-body text-center py-5">

                <h5 class="fw-semibold mb-2">
                    No Results Available
                </h5>

                <p class="text-secondary mb-0">
                    No quiz results are available yet.
                </p>

            </div>

        </div>
    }
    else
    {
        <!-- Results Table -->

        <div class="card border-0 shadow-sm">

            <div class="card-body p-0">

                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th class="px-4 py-3">
                                    Participant
                                </th>

                                <th class="py-3">
                                    Quiz
                                </th>

                                <th class="py-3">
                                    Subject
                                </th>

                                <th class="py-3">
                                    Score
                                </th>

                                <th class="py-3">
                                    Percentage
                                </th>

                                <th class="py-3">
                                    Result
                                </th>

                                <th class="py-3">
                                    Attempted On
                                </th>

                                <th class="py-3 pe-4">
                                    Details
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var result in Model)
                            {
                                <tr>

                                    <!-- Participant -->

                                    <td class="px-4 py-3">

                                        <div class="fw-semibold">
                                            @result.QuizAttempt?.Participant?.FullName
                                        </div>

                                        <div class="text-secondary small mt-1">
                                            @result.QuizAttempt?.Participant?.Email
                                        </div>

                                    </td>


                                    <!-- Quiz -->

                                    <td class="py-3">

                                        <span class="fw-semibold">
                                            @result.QuizAttempt?.Quiz?.Title
                                        </span>

                                    </td>


                                    <!-- Subject -->

                                    <td class="py-3">

                                        <span class="text-secondary">
                                            @result.QuizAttempt?.Quiz?.Subject?.Name
                                        </span>

                                    </td>


                                    <!-- Score -->

                                    <td class="py-3">

                                        <span class="fw-semibold">
                                            @result.Score
                                        </span>

                                        <span class="text-secondary">
                                            / @result.TotalMarks
                                        </span>

                                    </td>


                                    <!-- Percentage -->

                                    <td class="py-3">

                                        <span class="fw-semibold">
                                            @result.Percentage.ToString("0.00")%
                                        </span>

                                    </td>


                                    <!-- Result -->

                                    <td class="py-3">

                                        @if (result.IsPassed)
                                        {
                                            <span class="badge bg-success">
                                                PASS
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                FAIL
                                            </span>
                                        }

                                    </td>


                                    <!-- Attempted On -->

                                    <td class="py-3">

                                        <span class="text-secondary">
                                            @result.QuizAttempt?.EndTime?.ToString("dd-MM-yyyy HH:mm")
                                        </span>

                                    </td>


                                    <!-- Details -->

                                    <td class="py-3 pe-4">

                                        <a asp-controller="Admin"
                                           asp-action="ResultDetails"
                                           asp-route-id="@result.Id"
                                           class="btn btn-sm btn-outline-dark">

                                            View Details

                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }


    <!-- Back Button -->

    <div class="mt-4">

        <a asp-controller="Admin"
           asp-action="Index"
           class="btn btn-outline-dark px-4">

            Back to Admin Dashboard

        </a>

    </div>

</div>