@model IEnumerable<online_quiz.Models.ApplicationUser>

@{
    ViewData["Title"] = "User Management";

    var userRoles =
        ViewBag.UserRoles as Dictionary<string, string>
        ?? new Dictionary<string, string>();
}

<div class="container py-4">

    <!-- Page Header -->

    <div class="mb-5">

        <p class="text-secondary text-uppercase fw-semibold small mb-2">
            Users
        </p>

        <h1 class="fw-semibold mb-2">
            User Management
        </h1>

        <p class="text-secondary mb-0">
            View registered Faculty and Participants and manage their
            account status.
        </p>

    </div>


    @if (!Model.Any())
    {
        <!-- Empty State -->

        <div class="card border-0 shadow-sm">

            <div class="card-body text-center py-5">

                <h5 class="fw-semibold mb-2">
                    No Users Available
                </h5>

                <p class="text-secondary mb-0">
                    No Faculty or Participants are registered yet.
                </p>

            </div>

        </div>
    }
    else
    {
        <!-- User Table -->

        <div class="card border-0 shadow-sm">

            <div class="card-body p-0">

                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th class="px-4 py-3">
                                    Full Name
                                </th>

                                <th class="py-3">
                                    Email
                                </th>

                                <th class="py-3">
                                    Role
                                </th>

                                <th class="py-3">
                                    Status
                                </th>

                                <th class="py-3 pe-4">
                                    Action
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var user in Model)
                            {
                                string role = "Unknown";

                                if (userRoles.ContainsKey(user.Id))
                                {
                                    role = userRoles[user.Id];
                                }

                                <tr>

                                    <!-- Full Name -->

                                    <td class="px-4 py-3">

                                        <span class="fw-semibold">
                                            @user.FullName
                                        </span>

                                    </td>


                                    <!-- Email -->

                                    <td class="py-3">

                                        <span class="text-secondary">
                                            @user.Email
                                        </span>

                                    </td>


                                    <!-- Role -->

                                    <td class="py-3">

                                        @if (role == "FACULTY")
                                        {
                                            <span class="badge bg-secondary">
                                                FACULTY
                                            </span>
                                        }
                                        else if (role == "PARTICIPANT")
                                        {
                                            <span class="badge bg-secondary">
                                                PARTICIPANT
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @role
                                            </span>
                                        }

                                    </td>


                                    <!-- Status -->

                                    <td class="py-3">

                                        @if (user.IsActive)
                                        {
                                            <span class="badge bg-success">
                                                ACTIVE
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                INACTIVE
                                            </span>
                                        }

                                    </td>


                                    <!-- Action -->

                                    <td class="py-3 pe-4">

                                        @if (user.IsActive)
                                        {
                                            <form asp-controller="AdminUser"
                                                  asp-action="Deactivate"
                                                  asp-route-id="@user.Id"
                                                  method="post">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger">

                                                    Deactivate

                                                </button>

                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-controller="AdminUser"
                                                  asp-action="Activate"
                                                  asp-route-id="@user.Id"
                                                  method="post">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-success">

                                                    Activate

                                                </button>

                                            </form>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }


    <!-- Back Button -->

    <div class="mt-4">

        <a asp-controller="Admin"
           asp-action="Index"
           class="btn btn-outline-dark px-4">

            Back to Admin Dashboard

        </a>

    </div>

</div>