@{
    ViewData["Title"] = "Quiz Organizer Dashboard";
}

<div class="container py-4">

    <!-- Page Header -->
    <div class="mb-5">

        <p class="text-secondary text-uppercase fw-semibold small mb-2">
            Quiz Organizer Panel
        </p>

        <h1 class="fw-semibold mb-2">
            Quiz Organizer Dashboard
        </h1>

        <p class="text-secondary mb-0">
            Create and manage quizzes, and review participant responses
            from one place.
        </p>

    </div>

    <!-- Dashboard Tools -->
    <div class="mb-4">

        <h4 class="fw-semibold mb-1">
            Quiz Management
        </h4>

        <p class="text-secondary mb-0">
            Select an option below to manage your quizzes.
        </p>

    </div>

    <div class="row g-4">

        <!-- Create Quiz -->
        <div class="col-md-4">

            <div class="card h-100 border-0 shadow-sm rounded-3">

                <div class="card-body p-4 p-lg-5 d-flex flex-column">

                    <h5 class="fw-semibold mb-3">
                        Create Quiz
                    </h5>

                    <p class="text-secondary mb-4">
                        Create a new quiz, add questions, and prepare it
                        for submission.
                    </p>

                    <div class="mt-auto">

                        <a asp-controller="Quiz"
                           asp-action="Create"
                           class="btn btn-dark px-4">
                            Create Quiz
                        </a>

                    </div>

                </div>

            </div>

        </div>

        <!-- My Quizzes -->
        <div class="col-md-4">

            <div class="card h-100 border-0 shadow-sm rounded-3">

                <div class="card-body p-4 p-lg-5 d-flex flex-column">

                    <h5 class="fw-semibold mb-3">
                        My Quizzes
                    </h5>

                    <p class="text-secondary mb-4">
                        View and manage quizzes created by you.
                    </p>

                    <div class="mt-auto">

                        <a asp-controller="Quiz"
                           asp-action="Index"
                           class="btn btn-dark px-4">
                            My Quizzes
                        </a>

                    </div>

                </div>

            </div>

        </div>

        <!-- Responses -->
        <div class="col-md-4">

            <div class="card h-100 border-0 shadow-sm rounded-3">

                <div class="card-body p-4 p-lg-5 d-flex flex-column">

                    <h5 class="fw-semibold mb-3">
                        Responses
                    </h5>

                    <p class="text-secondary mb-4">
                        View participant responses and performance
                        for your quizzes.
                    </p>

                    <div class="mt-auto">

                        <a asp-controller="Quiz"
                           asp-action="Index"
                           class="btn btn-dark px-4">
                            View Responses
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>