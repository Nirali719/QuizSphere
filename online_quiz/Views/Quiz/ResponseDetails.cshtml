@model online_quiz.Models.Result

@{
    ViewData["Title"] = "Response Details";

    var answers =
        ViewBag.Answers as List<online_quiz.Models.StudentAnswer>;
}

<div class="container py-4">

    <!-- Page Header -->
    <div class="d-flex flex-column flex-md-row
        justify-content-between align-items-md-center mb-5">

        <div>

            <p class="text-secondary text-uppercase fw-semibold small mb-2">
                Reports
            </p>

            <h1 class="fw-semibold mb-2">
                Response Details
            </h1>

            <p class="text-secondary mb-0">
                Detailed participant response and performance information.
            </p>

        </div>

        <div class="mt-3 mt-md-0">

            <a asp-controller="Quiz"
               asp-action="Responses"
               asp-route-id="@Model.QuizAttempt.QuizId"
               class="btn btn-outline-dark px-4">
                Back to Responses
            </a>

        </div>

    </div>

    <!-- Participant & Quiz Information -->
    <div class="row g-4 mb-4">

        <!-- Participant Information -->
        <div class="col-md-6">

            <div class="card h-100 border-0 shadow-sm rounded-3">

                <div class="card-body p-4">

                    <p class="text-secondary text-uppercase fw-semibold small mb-2">
                        Participant
                    </p>

                    <h5 class="fw-semibold mb-4">
                        Participant Information
                    </h5>

                    <div class="mb-3">

                        <div class="text-secondary small">
                            Name
                        </div>

                        <div class="fw-semibold">
                            @Model.QuizAttempt.Participant?.FullName
                        </div>

                    </div>

                    <div>

                        <div class="text-secondary small">
                            Email
                        </div>

                        <div class="fw-semibold">
                            @Model.QuizAttempt.Participant?.Email
                        </div>

                    </div>

                </div>

            </div>

        </div>

        <!-- Quiz Information -->
        <div class="col-md-6">

            <div class="card h-100 border-0 shadow-sm rounded-3">

                <div class="card-body p-4">

                    <p class="text-secondary text-uppercase fw-semibold small mb-2">
                        Assessment
                    </p>

                    <h5 class="fw-semibold mb-4">
                        Quiz Information
                    </h5>

                    <div class="mb-3">

                        <div class="text-secondary small">
                            Quiz
                        </div>

                        <div class="fw-semibold">
                            @Model.QuizAttempt.Quiz?.Title
                        </div>

                    </div>

                    <div class="mb-3">

                        <div class="text-secondary small">
                            Subject
                        </div>

                        <div class="fw-semibold">
                            @Model.QuizAttempt.Quiz?.Subject?.Name
                        </div>

                    </div>

                    <div class="d-flex flex-wrap gap-4">

                        <div>

                            <div class="text-secondary small">
                                Total Marks
                            </div>

                            <div class="fw-semibold">
                                @Model.TotalMarks
                            </div>

                        </div>

                        <div>

                            <div class="text-secondary small">
                                Score
                            </div>

                            <div class="fw-semibold">
                                @Model.Score
                            </div>

                        </div>

                        <div>

                            <div class="text-secondary small">
                                Percentage
                            </div>

                            <div class="fw-semibold">
                                @Model.Percentage.ToString("0.00")%
                            </div>

                        </div>

                        <div>

                            <div class="text-secondary small">
                                Result
                            </div>

                            <div>

                                @if (Model.IsPassed)
                                {
                                    <span class="badge bg-success">
                                        PASS
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        FAIL
                                    </span>
                                }

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- Answer Summary -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">

        <div class="card-body p-4">

            <div class="mb-4">

                <p class="text-secondary text-uppercase fw-semibold small mb-2">
                    Performance
                </p>

                <h5 class="fw-semibold mb-0">
                    Answer Summary
                </h5>

            </div>

            <div class="row g-4 text-center">

                <div class="col-6 col-md-3">

                    <div class="border rounded-3 p-3 h-100">

                        <div class="text-secondary small mb-2">
                            Total Questions
                        </div>

                        <h4 class="fw-semibold mb-0">
                            @Model.TotalQuestions
                        </h4>

                    </div>

                </div>

                <div class="col-6 col-md-3">

                    <div class="border rounded-3 p-3 h-100">

                        <div class="text-secondary small mb-2">
                            Correct
                        </div>

                        <h4 class="fw-semibold text-success mb-0">
                            @Model.CorrectAnswers
                        </h4>

                    </div>

                </div>

                <div class="col-6 col-md-3">

                    <div class="border rounded-3 p-3 h-100">

                        <div class="text-secondary small mb-2">
                            Incorrect
                        </div>

                        <h4 class="fw-semibold text-danger mb-0">
                            @Model.IncorrectAnswers
                        </h4>

                    </div>

                </div>

                <div class="col-6 col-md-3">

                    <div class="border rounded-3 p-3 h-100">

                        <div class="text-secondary small mb-2">
                            Unattempted
                        </div>

                        <h4 class="fw-semibold text-warning mb-0">
                            @Model.Unattempted
                        </h4>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- Participant Responses -->
    <div class="card border-0 shadow-sm rounded-3">

        <div class="card-body p-4 p-lg-5">

            <div class="mb-4">

                <p class="text-secondary text-uppercase fw-semibold small mb-2">
                    Responses
                </p>

                <h5 class="fw-semibold mb-1">
                    Participant Responses
                </h5>

                <p class="text-secondary mb-0">
                    Review each question, the participant's answer,
                    and the correct answer.
                </p>

            </div>

            @if (answers != null && answers.Any())
            {
                int number = 1;

                @foreach (var answer in answers)
                {
                    var correctOption =
                        answer.Question?.Options?
                            .FirstOrDefault(o => o.IsCorrect);

                    bool isCorrect =
                        answer.SelectedOption != null &&
                        answer.SelectedOption.IsCorrect;

                    <div class="border rounded-3 p-4 mb-4">

                        <div class="d-flex justify-content-between
                            align-items-start mb-3">

                            <div>

                                <span class="text-secondary small">
                                    Question @number
                                </span>

                                <h6 class="fw-semibold mt-1 mb-0">
                                    @answer.Question?.QuestionText
                                </h6>

                            </div>

                            <span class="text-secondary small">
                                @answer.Question?.Marks mark(s)
                            </span>

                        </div>

                        <div class="mb-3">

                            <div class="text-secondary small mb-1">
                                Participant Answer
                            </div>

                            @if (answer.SelectedOption != null)
                            {
                                <div class="fw-semibold">
                                    @answer.SelectedOption.OptionText
                                </div>
                            }
                            else
                            {
                                <div class="text-secondary">
                                    Not Attempted
                                </div>
                            }

                        </div>

                        <div class="mb-3">

                            <div class="text-secondary small mb-1">
                                Correct Answer
                            </div>

                            @if (correctOption != null)
                            {
                                <div class="fw-semibold">
                                    @correctOption.OptionText
                                </div>
                            }
                            else
                            {
                                <div class="text-secondary">
                                    Not Available
                                </div>
                            }

                        </div>

                        <div>

                            @if (answer.SelectedOption == null)
                            {
                                <span class="badge bg-warning text-dark">
                                    Unattempted
                                </span>
                            }
                            else if (isCorrect)
                            {
                                <span class="badge bg-success">
                                    Correct
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger">
                                    Incorrect
                                </span>
                            }

                        </div>

                    </div>

                    number++;
                }
            }
            else
            {
                <div class="text-center py-4">

                    <p class="text-secondary mb-0">
                        No answers were recorded for this attempt.
                    </p>

                </div>
            }

        </div>

    </div>

</div>