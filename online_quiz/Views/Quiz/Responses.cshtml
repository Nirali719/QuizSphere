@model IEnumerable<online_quiz.Models.Result>

@{
    ViewData["Title"] = "Quiz Responses";

    var quiz = ViewBag.Quiz as online_quiz.Models.Quiz;
}

<div class="container py-4">

    <!-- Page Header -->
    <div class="d-flex flex-column flex-md-row
        justify-content-between align-items-md-center mb-5">

        <div>

            <p class="text-secondary text-uppercase fw-semibold small mb-2">
                Reports
            </p>

            <h1 class="fw-semibold mb-2">
                Quiz Responses
            </h1>

            @if (quiz != null)
            {
                <p class="text-secondary mb-0">
                    Review participant performance for
                    <span class="fw-semibold text-dark">
                        @quiz.Title
                    </span>
                    <span class="mx-1">·</span>
                    @quiz.Subject?.Name
                </p>
            }

        </div>

        <div class="mt-3 mt-md-0">

            <a asp-controller="Quiz"
               asp-action="Index"
               class="btn btn-outline-dark px-4">
                Back to My Quizzes
            </a>

        </div>

    </div>

    @if (!Model.Any())
    {
        <!-- Empty State -->
        <div class="card border-0 shadow-sm rounded-3">

            <div class="card-body text-center py-5">

                <h5 class="fw-semibold mb-2">
                    No Responses Yet
                </h5>

                <p class="text-secondary mb-0">
                    No participants have attempted this quiz yet.
                </p>

            </div>

        </div>
    }
    else
    {
        <!-- Responses Table -->
        <div class="card border-0 shadow-sm rounded-3">

            <div class="card-body p-0">

                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th class="px-4 py-3">
                                    Participant
                                </th>

                                <th class="py-3">
                                    Email
                                </th>

                                <th class="py-3">
                                    Score
                                </th>

                                <th class="py-3">
                                    Percentage
                                </th>

                                <th class="py-3">
                                    Result
                                </th>

                                <th class="py-3">
                                    Attempted On
                                </th>

                                <th class="px-4 py-3">
                                    Details
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var result in Model)
                            {
                                <tr>

                                    <!-- Participant -->
                                    <td class="px-4">

                                        <div class="fw-semibold">
                                            @result.QuizAttempt?.Participant?.FullName
                                        </div>

                                    </td>

                                    <!-- Email -->
                                    <td>

                                        <span class="text-secondary">
                                            @result.QuizAttempt?.Participant?.Email
                                        </span>

                                    </td>

                                    <!-- Score -->
                                    <td>

                                        <span class="fw-semibold">
                                            @result.Score
                                        </span>

                                        <span class="text-secondary">
                                            / @result.TotalMarks
                                        </span>

                                    </td>

                                    <!-- Percentage -->
                                    <td>

                                        @result.Percentage.ToString("0.00")%

                                    </td>

                                    <!-- Result -->
                                    <td>

                                        @if (result.IsPassed)
                                        {
                                            <span class="badge bg-success">
                                                PASS
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                FAIL
                                            </span>
                                        }

                                    </td>

                                    <!-- Attempted On -->
                                    <td>

                                        <span class="text-secondary">
                                            @result.QuizAttempt?.EndTime?.ToString("dd-MM-yyyy HH:mm")
                                        </span>

                                    </td>

                                    <!-- Details -->
                                    <td class="px-4">

                                        <a asp-controller="Quiz"
                                           asp-action="ResponseDetails"
                                           asp-route-id="@result.Id"
                                           class="btn btn-sm btn-outline-dark">
                                            View Details
                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }

</div>