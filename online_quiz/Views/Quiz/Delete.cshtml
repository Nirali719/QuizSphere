@model online_quiz.Models.Quiz

@{
    ViewData["Title"] = "Delete Quiz";
}

<div class="container mt-4">

    <h1>Delete Quiz</h1>

    <hr />

    <div class="alert alert-danger">
        <strong>Are you sure you want to delete this quiz?</strong>
        <br />
        This action will also remove its questions and options.
    </div>

    <dl class="row">

        <dt class="col-sm-3">
            Quiz Title
        </dt>

        <dd class="col-sm-9">
            @Model.Title
        </dd>

        <dt class="col-sm-3">
            Subject
        </dt>

        <dd class="col-sm-9">
            @Model.Subject?.Name
        </dd>

        <dt class="col-sm-3">
            Total Marks
        </dt>

        <dd class="col-sm-9">
            @Model.TotalMarks
        </dd>

        <dt class="col-sm-3">
            Passing Marks
        </dt>

        <dd class="col-sm-9">
            @Model.PassingMarks
        </dd>

        <dt class="col-sm-3">
            Time Limit
        </dt>

        <dd class="col-sm-9">
            @Model.TimeLimit minutes
        </dd>

        <dt class="col-sm-3">
            Maximum Attempts
        </dt>

        <dd class="col-sm-9">
            @if (Model.MaxAttempts == 0)
            {
                <span>Unlimited</span>
            }
            else
            {
                <span>@Model.MaxAttempts</span>
            }
        </dd>

        <dt class="col-sm-3">
            Status
        </dt>

        <dd class="col-sm-9">
            @Model.Status
        </dd>

    </dl>

    <form asp-controller="Quiz"
          asp-action="Delete"
          method="post">
        @Html.AntiForgeryToken()
        <input type="hidden"
               asp-for="Id" />

        <button type="submit"
                class="btn btn-danger">
            Delete Quiz
        </button>

        <a asp-action="Index"
           class="btn btn-secondary">
            Cancel
        </a>

    </form>


</div>