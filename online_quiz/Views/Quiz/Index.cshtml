@model IEnumerable<online_quiz.Models.Quiz>

@{
    ViewData["Title"] = "My Quizzes";
}

<div class="container py-4">

    <!-- Page Header -->
    <div class="d-flex flex-column flex-md-row
        justify-content-between align-items-md-center mb-5">

        <div>
            <p class="text-secondary text-uppercase fw-semibold small mb-2">
                Quiz Management
            </p>

            <h1 class="fw-semibold mb-2">
                My Quizzes
            </h1>

            <p class="text-secondary mb-0">
                Manage the quizzes created by you.
            </p>
        </div>

        <div class="mt-3 mt-md-0">
            <a asp-controller="Quiz"
               asp-action="Create"
               class="btn btn-dark px-4">
                Create New Quiz
            </a>
        </div>

    </div>

    <!-- Success Message -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm mb-4">
            @TempData["Success"]
        </div>
    }

    <!-- Error Message -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger border-0 shadow-sm mb-4">
            @TempData["Error"]
        </div>
    }

    @if (!Model.Any())
    {
        <!-- Empty State -->
        <div class="card border-0 shadow-sm rounded-3">

            <div class="card-body text-center py-5">

                <h5 class="fw-semibold mb-2">
                    No Quizzes Yet
                </h5>

                <p class="text-secondary mb-4">
                    You have not created any quizzes yet.
                </p>

                <a asp-controller="Quiz"
                   asp-action="Create"
                   class="btn btn-dark px-4">
                    Create Your First Quiz
                </a>

            </div>

        </div>
    }
    else
    {
        <!-- Quiz Table -->
        <div class="card border-0 shadow-sm rounded-3">

            <div class="card-body p-0">

                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>
                                <th class="px-4 py-3">
                                    Title
                                </th>

                                <th class="py-3">
                                    Category
                                </th>

                                <th class="py-3">
                                    Subject
                                </th>

                                <th class="py-3">
                                    Marks
                                </th>

                                <th class="py-3">
                                    Time
                                </th>

                                <th class="py-3">
                                    Attempts
                                </th>

                                <th class="py-3">
                                    Status
                                </th>

                                <th class="px-4 py-3">
                                    Actions
                                </th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var quiz in Model)
                            {
                                <tr>

                                    <!-- Title -->
                                    <td class="px-4">
                                        <div class="fw-semibold">
                                            @quiz.Title
                                        </div>
                                    </td>

                                    <!-- Category -->
                                    <td>
                                        <span class="text-secondary">
                                            @quiz.Subject?.Category?.Name
                                        </span>
                                    </td>

                                    <!-- Subject -->
                                    <td>
                                        <span class="text-secondary">
                                            @quiz.Subject?.Name
                                        </span>
                                    </td>

                                    <!-- Marks -->
                                    <td>
                                        <div>
                                            <span class="fw-semibold">
                                                @quiz.TotalMarks
                                            </span>
                                            <span class="text-secondary">
                                                / @quiz.PassingMarks
                                            </span>
                                        </div>

                                        <small class="text-secondary">
                                            Total / Passing
                                        </small>
                                    </td>

                                    <!-- Time -->
                                    <td>
                                        @quiz.TimeLimit min
                                    </td>

                                    <!-- Max Attempts -->
                                    <td>
                                        @if (quiz.MaxAttempts == 0)
                                        {
                                            <span class="text-secondary">
                                                Unlimited
                                            </span>
                                        }
                                        else
                                        {
                                            <span>
                                                @quiz.MaxAttempts
                                            </span>
                                        }
                                    </td>

                                    <!-- Status -->
                                    <td>

                                        @if (quiz.Status == "DRAFT")
                                        {
                                            <span class="badge bg-secondary">
                                                DRAFT
                                            </span>
                                        }
                                        else if (quiz.Status == "PENDING")
                                        {
                                            <span class="badge bg-warning text-dark">
                                                PENDING
                                            </span>
                                        }
                                        else if (quiz.Status == "APPROVED")
                                        {
                                            <span class="badge bg-success">
                                                APPROVED
                                            </span>
                                        }
                                        else if (quiz.Status == "REJECTED")
                                        {
                                            <span class="badge bg-danger">
                                                REJECTED
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @quiz.Status
                                            </span>
                                        }

                                    </td>

                                    <!-- Actions -->
                                    <td class="px-4">

                                        <div class="d-flex flex-wrap gap-2">

                                            <a asp-controller="Question"
                                               asp-action="Index"
                                               asp-route-quizId="@quiz.Id"
                                               class="btn btn-sm btn-outline-dark">
                                                Questions
                                            </a>

                                            <a asp-controller="Quiz"
                                               asp-action="Responses"
                                               asp-route-id="@quiz.Id"
                                               class="btn btn-sm btn-outline-dark">
                                                Responses
                                            </a>

                                            <a asp-controller="Quiz"
                                               asp-action="Edit"
                                               asp-route-id="@quiz.Id"
                                               class="btn btn-sm btn-outline-dark">
                                                Edit
                                            </a>

                                            <a asp-controller="Quiz"
                                               asp-action="Delete"
                                               asp-route-id="@quiz.Id"
                                               class="btn btn-sm btn-outline-danger">
                                                Delete
                                            </a>

                                            @if (quiz.Status == "DRAFT")
                                            {
                                                <form asp-controller="Quiz"
                                                      asp-action="SubmitForApproval"
                                                      asp-route-id="@quiz.Id"
                                                      method="post"
                                                      class="d-inline">

                                                    @Html.AntiForgeryToken()

                                                    <button type="submit"
                                                            class="btn btn-sm btn-dark">
                                                        Submit for Approval
                                                    </button>

                                                </form>
                                            }
                                            else if (quiz.Status == "PENDING")
                                            {
                                                <span class="badge bg-secondary align-self-center">
                                                    Already Submitted
                                                </span>
                                            }
                                            else if (quiz.Status == "APPROVED")
                                            {
                                                <span class="badge bg-success align-self-center">
                                                    Approved
                                                </span>
                                            }
                                            else if (quiz.Status == "REJECTED")
                                            {
                                                <form asp-controller="Quiz"
                                                      asp-action="SubmitForApproval"
                                                      asp-route-id="@quiz.Id"
                                                      method="post"
                                                      class="d-inline">

                                                    @Html.AntiForgeryToken()

                                                    <button type="submit"
                                                            class="btn btn-sm btn-dark">
                                                        Submit Again
                                                    </button>

                                                </form>
                                            }

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }

</div>